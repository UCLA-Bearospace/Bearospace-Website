{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/technical-programs", "destination": "/engineering", "permanent": true },
    { "source": "/technical-programs/aerodynamics", "destination": "/engineering/aerodynamics", "permanent": true },
    { "source": "/technical-programs/internalexternal-structures", "destination": "/engineering/structures", "permanent": true },
    { "source": "/technical-programs/recovery-systems", "destination": "/engineering/recovery", "permanent": true },
    { "source": "/technical-programs/electronics", "destination": "/engineering/avionics", "permanent": true },
    { "source": "/technical-programs/payload-electronics", "destination": "/engineering/payload-electronics", "permanent": true },
    { "source": "/technical-programs/payload-development", "destination": "/engineering/payload", "permanent": true },
    { "source": "/technical-programs/safety-operations", "destination": "/engineering/safety-operations", "permanent": true },
    { "source": "/photos", "destination": "/gallery", "permanent": true },
    { "source": "/contact", "destination": "/join", "permanent": true },
    { "source": "/about/sponsorship", "destination": "/sponsors", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
