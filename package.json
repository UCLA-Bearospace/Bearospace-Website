{
  "name": "bearospace-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run images",
    "dev": "vite",
    "prebuild": "npm run validate && npm run images",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs dist",
    "prebuild:test": "npm run validate && npm run images",
    "build:test": "vite build --mode test --outDir dist-test && vite build --mode test --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs dist-test",
    "preview": "vite preview",
    "lint": "eslint .",
    "validate": "node scripts/validate-content.mjs",
    "images": "node scripts/build-images.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "models": "node scripts/build-rocket.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "prerender": "node scripts/prerender.mjs dist",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:perf": "playwright test --project chromium-gpu",
    "lhci": "npx -y @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  }
}
